def generate_hints_for_level(word: str, subcategory: str, level: int) -> List[str]:
    """Generate 6 hints for a specific difficulty level."""
    word_lower = word.lower()
    hints = []
    
    if level == 3:  # Easy - direct
        hints = [
            f"This {subcategory.lower()} brand is called {word}",
            f"A famous {subcategory.lower()} company named {word}",
            f"The {subcategory.lower()} giant known as {word}",
            f"Popular {subcategory.lower()} brand: {word}",
            f"Leading {subcategory.lower()} name: {word}",
            f"Well-known {subcategory.lower()} brand {word}",
        ]
    elif level == 2:  # Medium - indirect
        attrs = get_brand_attributes(word, subcategory)
        hints = [
            f"Their logo features {attrs.get('logo', 'a distinctive symbol')}",
            f"Known for {attrs.get('known_for', 'innovative products')}",
            f"Founded in {attrs.get('founded', 'the 20th century')}",
            f"Headquartered in {attrs.get('hq', 'a major city')}",
            f"Their slogan: {attrs.get('slogan', 'memorable tagline')}",
            f"Competes with {attrs.get('rivals', 'other major brands')}",
        ]
    else:  # level == 1, Hard - subtle
        attrs = get_brand_attributes(word, subcategory)
        hints = [
            f"The {attrs.get('origin', 'global')} brand behind {attrs.get('key_product', 'iconic products')}",
            f"Stock ticker: {attrs.get('ticker', 'NYSE listed')}",
            f"Acquired {attrs.get('acquisition', 'notable companies')}",
            f"CEO: {attrs.get('ceo', 'industry leader')}",
            f"Revenue exceeds {attrs.get('revenue', 'billions annually')}",
            f"Pioneered {attrs.get('innovation', 'industry standards')}",
        ]
    
    filtered = [h for h in hints if word_lower not in h.lower()]
    return filtered[:6]
